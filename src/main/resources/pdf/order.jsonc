{
  // Identidade inspirada no pedido impresso da Minastex; dados continuam externos.
  "page": { "size": "A4", "orientation": "PORTRAIT", "margin": 40 },
  "fonts": {
    "regular": "/pack/utilities/pdf/fonts/DejaVuSans.ttf",
    "bold": "/pack/utilities/pdf/fonts/DejaVuSans-Bold.ttf"
  },
  "pageHeader": [
    {
      "type": "COLUMNS", "gap": 26, "minHeight": 84, "spacingAfter": 7,
      "columns": [
        { "weight": 3, "body": [
          { "type": "IMAGE", "path": "${company.logo}", "fallbackResource": "/assets/minastex-logo.png",
            "maxWidth": 195, "maxHeight": 76, "spacingAfter": 0 }
        ]},
        { "weight": 2, "body": [
          { "type": "TEXT", "value": "${order.label}", "fontSize": 16, "bold": true,
            "align": "RIGHT", "color": "#1F4E89", "spacingAfter": 5 },
          { "type": "TEXT", "value": "${order.number}", "fontSize": 9, "bold": true,
            "align": "RIGHT", "color": "#1F4E89", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${order.date}", "fontSize": 8,
            "align": "RIGHT", "color": "#46566A", "spacingAfter": 0 }
        ]}
      ]
    },
    { "type": "LINE", "width": 2, "color": "#1F4E89", "spacingAfter": 16 }
  ],
  "body": [
    { "type": "BAND", "value": "DADOS DO CLIENTE", "height": 22,
      "backgroundColor": "#1F4E89", "color": "#FFFFFF", "fontSize": 9, "bold": true, "spacingAfter": 11 },
    { "type": "TEXT", "value": "CLIENTE", "fontSize": 7, "bold": true,
      "color": "#68788C", "spacingAfter": 2 },
    { "type": "TEXT", "value": "${client.name}", "fontSize": 13, "bold": true,
      "color": "#1F4E89", "spacingAfter": 11 },
    {
      "type": "COLUMNS", "gap": 22, "minHeight": 48, "spacingAfter": 12,
      "columns": [
        { "weight": 3, "body": [
          { "type": "TEXT", "value": "CPF / CNPJ", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${client.document}", "fontSize": 9, "bold": true, "spacingAfter": 0 }
        ]},
        { "weight": 2, "body": [
          { "type": "TEXT", "value": "TELEFONE", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${client.phone}", "fontSize": 9, "bold": true, "spacingAfter": 0 }
        ]},
        { "weight": 2, "body": [
          { "type": "TEXT", "value": "E-MAIL", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${client.email}", "fontSize": 8, "bold": true, "spacingAfter": 0 }
        ]}
      ]
    },
    { "type": "BAND", "value": "ITENS DO PEDIDO", "height": 22,
      "backgroundColor": "#1F4E89", "color": "#FFFFFF", "fontSize": 9, "bold": true, "spacingAfter": 0 },
    {
      "type": "TABLE", "rowsPath": "items", "fontSize": 8.5, "headerFontSize": 8,
      "rowHeight": 29, "cellPadding": 7, "spacingAfter": 15,
      "headerBackgroundColor": "#245A9B", "headerTextColor": "#FFFFFF",
      "textColor": "#263445", "alternateRowColor": "#F3F6FA",
      "borderColor": "#D7DFE9", "borderWidth": 0.45,
      "columns": [
        { "header": "DESCRIÇÃO", "value": "${description}", "weight": 5 },
        { "header": "QUANTIDADE", "value": "${quantity}", "weight": 2, "align": "CENTER" },
        { "header": "PREÇO UNITÁRIO", "value": "${unitPrice}", "weight": 2, "align": "RIGHT" },
        { "header": "TOTAL", "value": "${value}", "weight": 2, "align": "RIGHT" }
      ]
    },
    {
      "type": "COLUMNS", "gap": 18, "minHeight": 78, "spacingAfter": 15,
      "columns": [
        { "weight": 3, "body": [
          { "type": "IF", "path": "notes", "body": [
            { "type": "TEXT", "value": "OBSERVAÇÕES", "fontSize": 7, "bold": true,
              "color": "#68788C", "spacingAfter": 2 },
            { "type": "TEXT", "value": "${notes}", "fontSize": 8, "spacingAfter": 0 }
          ]}
        ]},
        { "weight": 2, "body": [
          { "type": "COLUMNS", "gap": 8, "minHeight": 14, "columns": [
            { "weight": 1, "body": [{ "type": "TEXT", "value": "SUBTOTAL", "fontSize": 8, "bold": true, "align": "RIGHT" }]},
            { "weight": 1, "body": [{ "type": "TEXT", "value": "${subtotal}", "fontSize": 9, "align": "RIGHT" }]}
          ]},
          { "type": "COLUMNS", "gap": 8, "minHeight": 14, "columns": [
            { "weight": 1, "body": [{ "type": "TEXT", "value": "${ipiLabel}", "fontSize": 8, "bold": true, "align": "RIGHT" }]},
            { "weight": 1, "body": [{ "type": "TEXT", "value": "${ipi}", "fontSize": 9, "align": "RIGHT" }]}
          ]},
          { "type": "BAND", "value": "TOTAL DO PEDIDO   ${total}", "height": 25,
            "backgroundColor": "#1F4E89", "color": "#FFFFFF", "fontSize": 10,
            "bold": true, "align": "RIGHT", "spacingAfter": 0 }
        ]}
      ]
    },
    { "type": "BAND", "value": "INFORMAÇÕES COMERCIAIS", "height": 22,
      "backgroundColor": "#1F4E89", "color": "#FFFFFF", "fontSize": 9, "bold": true, "spacingAfter": 11 },
    {
      "type": "COLUMNS", "gap": 20, "minHeight": 60, "spacingAfter": 10,
      "columns": [
        { "weight": 1, "body": [
          { "type": "LINE", "width": 2, "color": "#9ECD85", "spacingAfter": 12 },
          { "type": "TEXT", "value": "FORMA DE PAGAMENTO", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${payment}", "fontSize": 10, "bold": true,
            "color": "#1F4E89", "spacingAfter": 0 }
        ]},
        { "weight": 1, "body": [
          { "type": "LINE", "width": 2, "color": "#9ECD85", "spacingAfter": 12 },
          { "type": "TEXT", "value": "FRETE", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${frete}", "fontSize": 10, "bold": true,
            "color": "#1F4E89", "spacingAfter": 0 }
        ]},
        { "weight": 1, "body": [
          { "type": "LINE", "width": 2, "color": "#9ECD85", "spacingAfter": 12 },
          { "type": "TEXT", "value": "PRAZO", "fontSize": 7, "bold": true,
            "color": "#68788C", "spacingAfter": 2 },
          { "type": "TEXT", "value": "${prazo}", "fontSize": 10, "bold": true,
            "color": "#1F4E89", "spacingAfter": 0 }
        ]}
      ]
    },
    { "type": "IF", "path": "pickup", "body": [
      { "type": "TEXT", "value": "Retirada: ${pickup}", "fontSize": 8, "spacingAfter": 4 }
    ]},
    { "type": "IF", "path": "peso", "body": [
      { "type": "TEXT", "value": "Peso: ${peso}", "fontSize": 8, "spacingAfter": 4 }
    ]},
    { "type": "IF", "path": "showBank", "body": [
      { "type": "SPACER", "height": 5 },
      { "type": "BAND", "value": "DADOS BANCÁRIOS", "height": 20,
        "backgroundColor": "#EEF3F9", "color": "#1F4E89", "fontSize": 8, "bold": true, "spacingAfter": 5 },
      { "type": "TEXT", "value": "${bankText}", "fontSize": 8, "spacingAfter": 3 },
      { "type": "IF", "path": "pix", "body": [
        { "type": "TEXT", "value": "PIX: ${pix}", "fontSize": 8, "spacingAfter": 0 }
      ]}
    ]}
  ]
}
